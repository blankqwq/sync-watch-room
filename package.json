{
  "name": "sync-watch-room",
  "version": "0.1.0",
  "description": "A synchronized watch room with real-time chat, WebRTC voice, and resilient playback sync.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "NODE_ENV=development SESSION_COOKIE_SECURE=false PORT=4174 SERVE_STATIC=false ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173 node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "setup:env": "sh scripts/setup-env.sh",
    "test": "node --test server/*.test.js src/*.test.js",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "pg": "^8.23.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "hls.js": "^1.7.3",
    "lucide-vue-next": "^0.544.0",
    "vite": "^7.1.5",
    "vue": "^3.5.21"
  }
}
