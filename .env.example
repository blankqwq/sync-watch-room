# Docker Compose public port
APP_PORT=8088

# Browser build settings. Leave VITE_WS_URL empty when /ws is reverse-proxied on the same domain.
VITE_WS_URL=
VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Node.js signaling service
NODE_ENV=production
HOST=0.0.0.0
PORT=4174
WS_PATH=/ws
SERVE_STATIC=false
HEARTBEAT_INTERVAL_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
WS_MAX_PAYLOAD_BYTES=65536
ALLOWED_ORIGINS=https://watch.example.com
