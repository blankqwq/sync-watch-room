# Docker Compose public port
APP_PORT=8088
APP_BIND=127.0.0.1

# Browser build settings. Leave VITE_WS_URL empty when /ws is reverse-proxied on the same domain.
VITE_WS_URL=

# Node.js signaling service
NODE_ENV=production
HOST=0.0.0.0
PORT=4174
WS_PATH=/ws
SERVE_STATIC=false
HEARTBEAT_INTERVAL_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
WS_MAX_PAYLOAD_BYTES=65536
ALLOWED_ORIGINS=https://watch.example.com

# Admin and media catalog. Generate token with: openssl rand -hex 32
ADMIN_TOKEN=
DATA_DIR=
POSTGRES_USER=watch_room
POSTGRES_DB=watch_room
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
DATABASE_URL=
SESSION_COOKIE_SECURE=
# Initial sources: label|HTTPS MacCMS V10 endpoint, comma-separated.
# Admin source settings in DATA_DIR/sources.json take precedence once saved.
MACCMS_SOURCES=

# Alibaba Cloud OSS (all five values are required to enable browser uploads)
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_URL=

# STUN/TURN. Generate the shared secret with: openssl rand -hex 32
STUN_URLS=stun:turn.example.com:3478
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_SHARED_SECRET=replace-with-at-least-32-random-characters
TURN_CREDENTIAL_TTL_SECONDS=3600
TURN_REALM=watch.example.com
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
TURN_EXTERNAL_IP=
TURN_RELAY_IP=
TURN_DETECT_EXTERNAL_IP=yes
TURN_MAX_BPS=1048576
